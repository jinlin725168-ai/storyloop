    "README.md": "# Public title comparison calibration fixture\n\nThe initial implementation incorrectly used lower() and failed tests/test_titles.py.\nThe fix uses NFKC, casefold and collapsed whitespace only for comparisons.\nDisplay titles and item order must remain intact. Café and cafe remain distinct.\nStoryLoop run metadata in this fixture is simulated; the red/green tests actually run.\n",
    "app/__init__.py": "",
    "app/store.py": "import unicodedata\n\n\ndef _title_key(value):\n    return ' '.join(unicodedata.normalize('NFKC', value).casefold().split())\n\n\ndef find_by_title(items, title):\n    key = _title_key(title)\n    return [item for item in items if _title_key(item['title']) == key]\n",
    "tests/test_titles.py": "import copy\nimport unittest\nfrom app.store import find_by_title\n\n\nclass TitleTests(unittest.TestCase):\n    def test_matching_preserves_display_order_and_data(self):\n        items = [{'title': 'Ｆｏｏ'}, {'title': 'Straße'}, {'title': '  Buy   milk  '},\n                 {'title': 'foo'}, {'title': 'café'}]\n        before = copy.deepcopy(items)\n        self.assertEqual(find_by_title(items, 'foo'), [items[0], items[3]])\n        self.assertEqual(find_by_title(items, 'STRASSE'), [items[1]])\n        self.assertEqual(find_by_title(items, 'buy milk'), [items[2]])\n        self.assertEqual(find_by_title(items, 'cafe'), [])\n        self.assertEqual(find_by_title(items, 'fo'), [])\n        self.assertEqual(items, before)\n"
  },
  "red_store_source": "def find_by_title(items, title):\n    return [item for item in items if item['title'].lower() == title.lower()]\n",
